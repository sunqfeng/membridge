# Server: dedicated database/user; URL-encode special password characters.
MYSQL_URL=mysql://membridge:REPLACE_PASSWORD@127.0.0.1:3306/membridge
MEMBRIDGE_TOKENS_FILE=./agent-tokens.json
HOST=127.0.0.1
PORT=8787

# Client: distinct token/agent per installation, same project slug for sharing.
MEMBRIDGE_URL=https://memory.example.com
MEMBRIDGE_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN
MEMBRIDGE_AGENT=codex-main
MEMBRIDGE_CACHE_TTL_MS=60000
